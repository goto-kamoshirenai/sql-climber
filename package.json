{
  "name": "sql-climber",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/prepare-assets.mts && next dev",
    "build": "tsx scripts/prepare-assets.mts && next build",
    "start": "next start",
    "assets": "tsx scripts/prepare-assets.mts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:content": "tsx scripts/validate-content.mts",
    "e2e": "playwright test",
    "format": "prettier --write .",
    "check": "eslint . && tsc --noEmit && vitest run && tsx scripts/validate-content.mts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@electric-sql/pglite": "0.5.8",
    "@lezer/highlight": "1.2.5",
    "dotterel-ui": "0.7.1",
    "marked": "18.1.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sql.js": "1.14.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sql.js": "1.4.11",
    "beautiful-mermaid": "1.1.3",
    "eslint": "9.39.2",
    "eslint-config-next": "16.4.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@12.10.1"
}
